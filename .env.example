# Copy this file to `.env` and fill in your real Stripe keys (keep `.env` out of git).
# Get your keys from: https://dashboard.stripe.com/apikeys

# Publishable key — safe to expose in the browser. Must be VITE_ prefixed to be
# readable from client code via import.meta.env.VITE_STRIPE_PUBLISHABLE_KEY
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secret key — SERVER-SIDE ONLY. Never prefix with VITE_ and never use it in
# frontend code; it must live on a backend / serverless function.
# In production set this in Vercel → Settings → Environment Variables (NOT here).
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Webhook signing secret — SERVER-SIDE ONLY. From Stripe Dashboard → Developers →
# Webhooks → your endpoint (/api/stripe-webhook) → "Signing secret".
# Required for api/stripe-webhook.ts to verify events. Set in Vercel env.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional fallback — static Stripe Payment Links (Dashboard → Payment Links).
# Used by the client only if the /api/create-checkout-session call fails.
# BASE = ticket only ($97), BUMP = ticket + order bump ($124). Leave blank to disable.
VITE_STRIPE_PAYMENT_URL_BASE=https://buy.stripe.com/xxxxxxxxxxxxxxxx
VITE_STRIPE_PAYMENT_URL_BUMP=https://buy.stripe.com/yyyyyyyyyyyyyyyy
